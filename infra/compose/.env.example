# For local/development validation only. Replace both values on the test host.
ITSM_DB_PASSWORD=replace-with-random-test-password
ITSM_REDIS_PASSWORD=replace-with-random-test-password
ITSM_WEB_PORT=8088
ITSM_SEED_DEV_DATA=false
# Optional independent enterprise OIDC login. HTTPS and secure cookies are required.
ENABLE_OIDC_LOGIN=false
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Set the exact HTTPS origin in the private environment, together with COOKIE_SECURE=true.
ITSM_PUBLIC_URL=
# Keep OA disabled until the template, approval chain, app permissions and provider readback are accepted.
ENABLE_LIVE_OA_APPROVAL=false
ENABLE_MANUAL_REQUEST_DELIVERY=false
# Explicitly review app visibility and department scope before enabling automatic retirement.
ENABLE_DIRECTORY_SYNC=false
DINGTALK_DIRECTORY_ROOTS=
DINGTALK_PILOT_USER_IDS=
DIRECTORY_RETIRE_MISSING=false
DIRECTORY_MAX_REMOVAL_PERCENT=10
# Only reviewed service-code@form-version pairs can receive new requests.
ENABLE_REQUEST_INTAKE=false
REQUEST_INTAKE_CATALOG_VERSIONS=
REQUEST_APPROVAL_TIMEOUT_MINUTES=
# Approved security duty contact, plain text only. Never place credentials here.
ITSM_SECURITY_CONTACT=
# Audio may only reach a company-approved internal HTTPS transcription endpoint.
# Keep disabled until the data path and real Chinese speech samples are accepted.
ENABLE_VOICE_ASR=false
VOICE_ASR_DATA_BOUNDARY=
VOICE_ASR_APPROVAL_REF=
VOICE_ASR_ENDPOINT=
VOICE_ASR_MODEL=
VOICE_ASR_TOKEN=
# Technical escalation thresholds, not an approved business SLA. Existing deadlines stay unchanged.
FULFILLMENT_REVIEW_REMINDER_MINUTES=1440
FULFILLMENT_REVOKE_REMINDER_MINUTES=60
# Private controlled NAS/object volume and trusted internal ClamAV daemon; never expose port 3310 to users.
ENABLE_ATTACHMENTS=false
ATTACHMENT_STORAGE_APPROVAL_REF=
ATTACHMENT_SIGNING_KEY=
ATTACHMENT_CLAMD_HOST=
ATTACHMENT_CLAMD_PORT=3310
ATTACHMENT_MAX_BYTES=20971520
# CI or an isolated fixture-only environment may explicitly enable development seeds.
# For manual GHCR release, use the exact commit SHA.
# ITSM_IMAGE_PREFIX=ghcr.io/gomi95932/itsm
# ITSM_IMAGE_TAG=<commit-sha>
# ITSM_POSTGRES_IMAGE=ghcr.io/gomi95932/itsm-postgres:<commit-sha>
# ITSM_REDIS_IMAGE=ghcr.io/gomi95932/itsm-redis:<commit-sha>
