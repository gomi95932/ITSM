[Unit]
Description=Source filter for the ITSM development LAN entry
Before=itsm-dev-lan.socket itsm-dev-lan.service
After=network-pre.target
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft --file /etc/itsm-dev-lan.nft
ExecReload=/usr/sbin/nft --file /etc/itsm-dev-lan.nft
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
