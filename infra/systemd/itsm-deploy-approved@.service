[Unit]
Description=Execute one approved ITSM development deployment %i
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
WorkingDirectory=/opt/itsm/tools/release
ExecStart=/usr/bin/env -i PATH=/usr/bin:/bin HOME=/root LANG=C.UTF-8 /usr/bin/node /opt/itsm/tools/release/execute-approved-deployment.mjs %i
TimeoutStartSec=100min
TimeoutStopSec=30s
KillMode=control-group
SendSIGKILL=yes
Restart=no
LimitCORE=0
StandardOutput=journal
StandardError=journal
